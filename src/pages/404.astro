---
import { siteConfig } from "../config/site";
import "../styles/color-scheme-themes.css";

export const prerender = true;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | {siteConfig.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
        font-family:
          "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
        background: var(--bg);
        color: var(--text);
      }

      main {
        width: min(100%, 28rem);
        text-align: center;
      }

      .logo {
        width: 4.75rem;
        height: 4.75rem;
        border-radius: 999px;
        margin-bottom: 1.25rem;
      }

      h1 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      p {
        margin: 0 0 1.5rem;
        color: var(--muted);
        line-height: 1.5;
        font-size: 1.05rem;
      }

      a {
        color: var(--accent-soft);
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main>
      <img
        class="logo"
        src="/favicon.svg"
        alt=""
        width="76"
        height="76"
        decoding="async"
      />
      <h1>Page not found</h1>
      <p>That link doesn’t match anything on the blog.</p>
      <p><a href="/">← Back to the blog</a></p>
    </main>
  </body>
</html>
