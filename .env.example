# Neon — paste from Neon dashboard / Vercel Preview pull. Server-only; do not use PUBLIC_ prefix.
# Prefer Preview/Production env (not Vercel Development). Apply schema with: bun run db:migrate
POSTGRES_URL=

# Resend — server-only values used by newsletter sync and contact webhook verification.
# Sending key (may be send-only). Optional if you only run sync and set RESEND_CONTACTS_API_KEY.
RESEND_API_KEY=
# Full-access key for Contacts API (bun run newsletter:sync). Required if RESEND_API_KEY is send-only.
RESEND_CONTACTS_API_KEY=
# Verified sender address for newsletter confirmation emails.
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Resend segment for this env (blog-prod / blog-preview). Required for contact sync.
RESEND_SEGMENT_ID=

# HMAC secret used to generate tokenized /newsletter/manage/* links.
NEWSLETTER_TOKEN_SECRET=

# PostHog (server-side API routes only; no browser SDK). Use the EU project token/host.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
